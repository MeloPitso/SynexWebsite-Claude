# Synex AI Labs — environment variables
#
# Copy to .env for local development (.env is gitignored), and set the same
# keys in the Vercel project's Environment Variables for production.
# Never commit real values.

# ── Airtable (required — a lead is rejected if these are missing) ──
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=your_airtable_table_name

# ── Zoho CRM Web-to-Lead (optional — skipped if unset) ──
# From the Zoho Web-to-Lead form's hidden fields:
#   ZOHO_WEBFORM_OWNER_ID -> the "xnQsjsdp" value
#   ZOHO_WEBFORM_SECRET   -> the "xmIwtLD" value
ZOHO_WEBFORM_OWNER_ID=your_zoho_webform_owner_id
ZOHO_WEBFORM_SECRET=your_zoho_webform_secret

# ── Resend — lead confirmation email (optional — skipped if unset) ──
RESEND_API_KEY=your_resend_api_key

# ── Telegram — new-lead notification (optional — skipped if unset) ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Anthropic — used only by the ARCHIVED chat endpoints (api/chat.js).
# Those endpoints return 410 and do not read this. Leave unset unless the
# chat widget is deliberately re-enabled.
ANTHROPIC_API_KEY=your_anthropic_api_key
